package testtwoo;
import java.util.Scanner;
import java.util.Scanner;
public class testtwoo {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
 
        int choice;
 
        do {
            System.out.println("\n===== MENU =====");
            System.out.println("[1] 20x20 Multiplication Table");
            System.out.println("[2] Odd-Even Balance");
            System.out.println("[3] Exit");
            System.out.print("Enter your choice: ");
            choice = input.nextInt();
 
            switch (choice) {
 
                case 1:
                    // 20x20 multiplication table using for loops
                    System.out.println("\n===== 20x20 MULTIPLICATION TABLE =====");
 
                    for (int i = 1; i <= 10; i++) {
                        for (int j = 1; j <= 10; j++) {
                            System.out.printf("%4d", i * j);
                        }
                        System.out.println();
                    }
                    break;
 
                case 2:
                    // Odd-Even Balance using while loop
                    int evenSum = 0;
                    int oddSum = 0;
                    int number;
 
                    System.out.println("\n===== ODD-EVEN BALANCE =====");
                    System.out.println("Enter positive integers.");
                    System.out.println("Enter -1 to stop.");
 
                    number = input.nextInt();
 
                    while (number != -1) {
                        if (number > 0) {
                            if (number % 2 == 0) {
                                evenSum += number;
                            } else {
                                oddSum += number;
                            }
                        } else {
                            System.out.println("Please enter a positive integer or -1.");
                        }
 
                        number = input.nextInt();
                    }
 
                    System.out.println("\nSum of even numbers: " + evenSum);
                    System.out.println("Sum of odd numbers: " + oddSum);
 
                    if (evenSum > oddSum) {
                        System.out.println("The sum of even numbers is greater than the sum of odd numbers.");
                    } else if (evenSum < oddSum) {
                        System.out.println("The sum of even numbers is less than the sum of odd numbers.");
                    } else {
                        System.out.println("The sum of even numbers is equal to the sum of odd numbers.");
                    }
                    break;
 
                case 3:
                    System.out.println("\nProgram terminated. Goodbye!");
                    break;
 
                default:
                    System.out.println("\nInvalid choice. Please select 1, 2, or 3.");
            }
 
        } while (choice != 3);
 
        input.close();
    }
}
